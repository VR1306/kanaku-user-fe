{
  "name": "kanaku-user-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,realtime -c cyan,magenta \"npm:dev:web\" \"npm:realtime\"",
    "dev:web": "next dev",
    "realtime": "tsx watch --env-file=.env.local server/realtime.ts",
    "build": "next build",
    "start": "concurrently -k -n web,realtime \"next start\" \"tsx server/realtime.ts\"",
    "lint": "eslint",
    "prepare": "husky",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:lines": "node scripts/check-file-length.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.10.1",
    "mongodb": "^7.8.0",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
