# Secret used to sign session cookies (min 32 chars).
SESSION_SECRET=

# --- Outgoing email (verification + password reset codes) ---
# Any SMTP provider works (Resend, SendGrid, Amazon SES, Postmark, Google Workspace, ...).
# Without these, development prints the email to the server console and nothing is delivered;
# production refuses to send.
SMTP_HOST=
SMTP_PORT=587
# "true" only for implicit-TLS port 465; keep "false" for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to users. Must be an address/domain your provider has verified (SPF/DKIM), e.g.
# MAIL_FROM="Kanaku <no-reply@your-domain.com>"
MAIL_FROM=
# Optional: where replies go, and a support address shown in the email footer.
MAIL_REPLY_TO=
SUPPORT_EMAIL=

# --- MongoDB (all app data: users, transactions, budgets, profiles) ---
# Atlas connection string (server-side only, never NEXT_PUBLIC_). Put the real value in .env.local.
MONGODB_URI=
MONGODB_DB=kanaku

# --- Frontend and backend addresses ---
# NEXT_APP_URL: the website. NEXT_API_URL: the API (the /api routes). They are public
# values (no secrets). With one deployment (the default) set both to the same address, or leave
# NEXT_API_URL empty. To host the API at its own address, deploy this repo a second time there,
# set NEXT_API_URL to it on the website's deployment, and share the login cookie between
# sibling subdomains with COOKIE_DOMAIN (e.g. app.example.com + api.example.com -> .example.com).
NEXT_APP_URL=http://localhost:3000
NEXT_API_URL=http://localhost:3000
COOKIE_DOMAIN=

# --- Realtime notifications (Socket.IO server in server/realtime.ts) ---
# Port the realtime server listens on, and the browser origins it accepts (comma-separated).
REALTIME_PORT=4000
APP_ORIGIN=http://localhost:3000
# Where the browser connects to it. Must be reachable from the user's browser.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# --- Razorpay (plans & billing) ---
# From the Razorpay dashboard (Settings > API Keys). Use Test Mode keys while developing.
# Keep the secret server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when adding the webhook (Settings > Webhooks) pointing at /api/billing/webhook.
# Optional but recommended: subscribe it to payment.captured and order.paid, so a payment is
# recorded even if the customer closes the tab right after paying.
RAZORPAY_WEBHOOK_SECRET=
# Optional: only to point at a different API host (e.g. a local mock for testing).
RAZORPAY_API_BASE=

# --- Support ---
# SUPPORT_EMAIL (above) also receives new support tickets.
# Secret (16+ characters) the support team's tooling sends as "Authorization: Bearer <key>" to
# POST /api/support/staff/tickets/<number>/reply. Leave empty to turn that endpoint off.
SUPPORT_API_KEY=
ADMIN_API_URL=
SERVICE_API_KEY=
REALTIME_SECRET=
NEXT_PUBLIC_CHAT_URL=
